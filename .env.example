PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=ecommerce_db

# Correo: usa credenciales de Mailtrap o EMAIL_PROVIDER=ethereal para pruebas.
# Nunca subas el archivo .env con credenciales reales ni configuración de AWS.
EMAIL_PROVIDER=mailtrap
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
EMAIL_FROM=no-reply@taller3m.local
ADMIN_EMAIL=admin@example.com
PAYMENT_INSTRUCTIONS=Realiza una transferencia bancaria y envía tu comprobante al administrador.
